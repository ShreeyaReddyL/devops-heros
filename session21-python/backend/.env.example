# Copy to `.env` for local development. Never commit the real `.env` file.
#
# LOCAL DEVELOPMENT CREDENTIALS ONLY.
# The values below match docker-compose.yml and are not production secrets.
# In Kubernetes the database password is supplied through a Helm-managed
# Kubernetes Secret instead of a value baked into the chart.

DATABASE_URL=postgresql+psycopg://campusfix:campusfix@localhost:5432/campusfix