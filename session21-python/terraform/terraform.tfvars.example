# Copy to terraform.tfvars and adjust. Never commit real credentials:
# AWS authentication comes from the AWS CLI profile selected with AWS_PROFILE,
# not from this file. Do not add access keys or other credentials here.

aws_region   = "ap-southeast-2"
cluster_name = "campusfix-eks"
environment  = "dev"

# Kubernetes version in Amazon EKS standard support (end of standard support
# March 2027). Do not use 1.31-1.33: those are extended support and bill higher.
cluster_version = "1.35"

vpc_cidr           = "10.20.0.0/16"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]

node_instance_types = ["t3.medium"]
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 2

# Keep empty for the current Free Tier project: its organization policy blocks
# GitHub Actions OIDC. Deploy manually from the authenticated AWS CLI session.
# Terraform grants EKS namespace access if this role is configured later.
github_actions_deploy_role_arn = ""
