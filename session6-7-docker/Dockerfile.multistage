# Stage 1: prepare the static site in a minimal build environment
FROM alpine:3.20 AS builder
WORKDIR /build
COPY multistage-index.html /build/index.html

# Stage 2: serve with nginx — only the HTML is carried over
FROM nginx:alpine
COPY --from=builder /build/index.html /usr/share/nginx/html/index.html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
